# Conexão com o MySQL externo (zalike_ia). Copie este arquivo para ".env"
# (que já está no .gitignore deste pacote) e preencha com os valores reais.
# IMPORTANTE: a senha abaixo foi compartilhada em texto puro em uma conversa
# de chat durante o desenvolvimento — troque-a antes de colocar isto em produção.
MYSQL_HOST=zalikecloud.access.ly
MYSQL_PORT=6338
MYSQL_USER=pedido_padrao
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=zalike_ia

# Porta em que este serviço vai escutar
PORT=3333

# Chave compartilhada que o frontend deve enviar no header "x-api-key".
# Gere um valor aleatório forte (ex: openssl rand -hex 32) — não reutilize
# a senha do MySQL nem nenhuma outra credencial.
API_KEY=gere-uma-chave-aleatoria-forte-aqui

# Origem pública do frontend (para CORS). Use a URL real do app publicado
# na Skip, não a URL interna do PocketBase.
ALLOWED_ORIGIN=https://seu-app.goskip.dev
